/* Endtime - Minimalist Terminal HUD Stylesheet (Red / White / Gray / Black) */

Screen {
    background: #000000;
    color: #888888;
    layout: vertical;
    scrollbar-color: #222222;
    scrollbar-color-active: #ff4444;
    scrollbar-color-hover: #ff6666;
    scrollbar-background: #050505;
    scrollbar-size-vertical: 1;
}

ModalScreen, SessionPickerModal, SessionOverlayModal, ScheduleModal, ReminderModal, HelpModal {
    background: rgba(0, 0, 0, 0.85);
    align: center middle;
}

#header {
    dock: top;
    width: 100%;
    height: auto;
    background: #050505;
    color: #888888;
    padding: 0 1;
    border-bottom: solid #1c1c1c;
    margin-bottom: 1;
}

#task-list {
    background: #000000;
    height: 1fr;
    overflow-x: hidden;
    scrollbar-color: #222222;
    scrollbar-color-active: #ff4444;
    scrollbar-color-hover: #ff6666;
    scrollbar-background: #000000;
    padding: 0 1;
}

CategoryItem {
    color: #ffffff;
    background: #000000;
    padding-top: 1;
    padding-left: 0;
    padding-bottom: 0;
    height: auto;
}

.category-label {
    color: #444444;
    text-style: bold;
}

CategoryItem:focus .category-label {
    color: #ffffff;
}

CategoryItem.--highlight {
    background: #0d0d0d;
}

TodoItem {
    layout: horizontal;
    background: #000000;
    color: #ffffff;
    padding-left: 0;
    padding-right: 0;
    height: auto;
}

TodoItem:focus {
    background: #0a0a0a;
}

TodoItem:focus Label {
    color: #ffffff;
}

.todo-status {
    width: 6;
    height: auto;
}

.todo-content {
    width: 1fr;
    height: auto;
}

TodoItem.--highlight {
    background: #111111;
}

TodoItem.-completed Label {
    color: #444444;
    text-style: strike;
}

#bottom-bar {
    dock: bottom;
    height: 1;
    background: #050505;
    padding: 0 1;
    margin: 0;
}

#prompt-prefix {
    width: 2;
    height: 1;
    color: #ff4444;
}

#prompt-label {
    height: 1;
    color: #888888;
}

#task-input {
    background: #050505;
    color: #ffffff;
    border: none;
    padding: 0;
    margin: 0;
    height: 1;
    width: 1fr;
}

#task-input:focus {
    border: none;
}

#task-input > .input--placeholder {
    color: #444444;
}

#task-input > .input--cursor {
    background: #ff4444;
    color: #000000;
}
