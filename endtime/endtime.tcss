Screen {
    background: #000000;
    color: #777777;
    layout: vertical;
    scrollbar-color: #333333;
    scrollbar-color-active: #ff4444;
    scrollbar-color-hover: #ff4444;
    scrollbar-background: #000000;
}

#header {
    dock: top;
    width: 100%;
    height: auto;
    background: #000000;
    color: #777777;
    margin-bottom: 1;
}

#task-list {
    background: #000000;
    height: 1fr;
    overflow-x: hidden;
    scrollbar-color: #333333;
    scrollbar-color-active: #ff4444;
    scrollbar-color-hover: #ff4444;
    scrollbar-background: #000000;
}

CategoryItem {
    color: #ffffff;
    background: #000000;
    padding-top: 1;
    padding-left: 0;
    padding-bottom: 0;
    height: auto;
}

.category-label {
    color: #333333;
    text-style: bold;
}

CategoryItem:focus .category-label {
    color: #ffffff;
}

TodoItem {
    layout: horizontal;
    background: #000000;
    color: #ffffff;
    padding-left: 0;
    padding-right: 0;
    height: auto;
}

TodoItem:focus {
    /* Focus doesn't alter styling anymore, handled by python formatting */
    background: #000000;
}

TodoItem:focus Label {
    color: #ffffff;
}

.todo-status {
    width: 6;
    height: auto;
}

.todo-content {
    width: 1fr;
    height: auto;
}

TodoItem.--highlight {
    background: #111111;
}

TodoItem.-completed Label {
    color: #333333;
    text-style: strike;
}

#bottom-bar {
    dock: bottom;
    height: 1;
    margin-top: 1;
    background: #000000;
}

#prompt-prefix {
    width: 2;
    color: #ff4444;
}

#prompt-label {
    color: #777777;
}

#task-input {
    background: #000000;
    color: #ffffff;
    border: none;
    padding: 0;
    width: 1fr;
}

#task-input:focus {
    border: none;
}

#task-input > .input--placeholder {
    color: #333333;
}

ModalScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

.dialog-box {
    width: 60;
    height: auto;
    background: #0d0d0d;
    border: solid #ff4444;
    padding: 1 2;
    layout: vertical;
}

.confirm-box {
    width: 50;
}

.dialog-title {
    text-align: center;
    color: #ff4444;
    text-style: bold;
    margin-bottom: 1;
    width: 100%;
}

.dialog-task {
    color: #ffffff;
    text-style: italic;
    margin-bottom: 1;
    text-align: center;
    width: 100%;
}

.dialog-msg {
    color: #ffffff;
    margin-bottom: 1;
    text-align: center;
    width: 100%;
}

.dialog-status-info {
    color: #ffffff;
    text-style: bold;
    background: #1a1a1a;
    margin-bottom: 1;
    text-align: center;
    width: 100%;
}

.dialog-btn {
    background: #1a1a1a;
    color: #777777;
    border: none;
    width: 100%;
    margin-bottom: 1;
    height: 3;
}

.dialog-btn:focus {
    background: #ff4444;
    color: #ffffff;
    text-style: bold;
}

.dialog-btn-small {
    background: #1a1a1a;
    color: #777777;
    border: none;
    width: 1fr;
    margin: 0 1;
    height: 3;
}

.dialog-btn-small:focus {
    background: #ff4444;
    color: #ffffff;
    text-style: bold;
}

.dialog-buttons {
    layout: horizontal;
    height: 3;
    width: 100%;
    margin-top: 1;
}

.confirm-btn:focus {
    background: #ff4444;
    color: #ffffff;
}

.cancel-btn:focus {
    background: #333333;
    color: #ffffff;
}

.save-btn:focus {
    background: #ff4444;
    color: #ffffff;
}

