/* Endtime - Minimalist HUD Stylesheet — Strict palette: #000000 / #888888 / #ffffff / #ff4444 */

Screen {
    background: #000000;
    color: #888888;
    layout: vertical;
    scrollbar-color: #222222;
    scrollbar-color-active: #ff4444;
    scrollbar-color-hover: #555555;
    scrollbar-background: #000000;
    scrollbar-size-vertical: 1;
}

ModalScreen, SessionPickerModal, SessionOverlayModal, ScheduleModal, ReminderModal, HelpModal {
    background: rgba(0, 0, 0, 0.82);
    align: center middle;
}

#header {
    dock: top;
    width: 100%;
    height: 1;
    background: #090909;
    color: #555555;
    padding: 0 1;
    border-bottom: solid #1c1c1c;
}

#task-list {
    background: #000000;
    height: 1fr;
    overflow-x: hidden;
    scrollbar-color: #222222;
    scrollbar-color-active: #ff4444;
    scrollbar-color-hover: #555555;
    scrollbar-background: #000000;
    padding: 0 1;
}

CategoryItem {
    color: #ffffff;
    background: #000000;
    padding-top: 1;
    padding-left: 0;
    padding-bottom: 0;
    height: auto;
}

.category-label {
    color: #444444;
    text-style: bold;
}

CategoryItem:focus .category-label {
    color: #ffffff;
}

CategoryItem.--highlight {
    background: #0d0d0d;
}

TodoItem {
    layout: horizontal;
    background: #000000;
    color: #aaaaaa;
    padding-left: 0;
    padding-right: 0;
    height: auto;
}

TodoItem:focus {
    background: #0a0a0a;
}

TodoItem:focus Label {
    color: #ffffff;
}

.todo-status {
    width: 6;
    height: auto;
}

.todo-content {
    width: 1fr;
    height: auto;
}

TodoItem.--highlight {
    background: #0f0f0f;
}

TodoItem.-completed Label {
    color: #333333;
    text-style: strike;
}

#bottom-bar {
    dock: bottom;
    height: 3;
    background: #090909;
    border-top: solid #1c1c1c;
    layout: horizontal;
    align: left middle;
    padding: 0 1;
}

#prompt-prefix {
    width: 2;
    height: 1;
    color: #ff4444;
    content-align: left middle;
}

#prompt-label {
    height: 1;
    color: #666666;
    content-align: left middle;
}

#task-input {
    background: #090909;
    color: #ffffff;
    border: none;
    padding: 0;
    margin: 0;
    width: 1fr;
    height: 1;
}

#task-input:focus {
    border: none;
    background: #090909;
}

#task-input > .input--placeholder {
    color: #333333;
}

#task-input > .input--cursor {
    color: #ffffff;
    background: #ff4444;
}
